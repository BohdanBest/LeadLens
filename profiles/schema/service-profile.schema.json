{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadlens.local/schemas/service-profile.schema.json",
  "title": "LeadLens Service Profile",
  "type": "object",
  "required": ["key", "version", "name", "categories", "checks", "email_templates"],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 2,
      "maxLength": 50
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "object",
      "required": ["uk", "en"],
      "additionalProperties": false,
      "properties": {
        "uk": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "weight", "name"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "name": {
            "type": "object",
            "required": ["uk", "en"],
            "additionalProperties": false,
            "properties": {
              "uk": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "weight", "impact", "effort", "service", "title", "description", "thresholds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{2}$" },
          "category": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
          "service": { "type": "string", "minLength": 1 },
          "service_label": {
            "type": "object",
            "required": ["uk", "en"],
            "additionalProperties": false,
            "properties": {
              "uk": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "title": {
            "type": "object",
            "required": ["uk", "en"],
            "additionalProperties": false,
            "properties": {
              "uk": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "description": {
            "type": "object",
            "required": ["uk", "en"],
            "additionalProperties": false,
            "properties": {
              "uk": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "claim_template": {
            "type": "object",
            "required": ["uk", "en"],
            "additionalProperties": false,
            "properties": {
              "uk": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "thresholds": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "email_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "tone", "length", "subject", "body"],
        "additionalProperties": false,
        "properties": {
          "language": { "type": "string", "enum": ["uk", "en"] },
          "tone": { "type": "string", "enum": ["formal", "friendly"] },
          "length": { "type": "string", "enum": ["short", "medium"] },
          "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
