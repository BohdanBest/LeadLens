COMPOSE_PROJECT_NAME=leadlens

# PostgreSQL
POSTGRES_DB=leadlens
POSTGRES_USER=leadlens
POSTGRES_PASSWORD=leadlens_dev_password_change_me
POSTGRES_PORT=5432

# Redis (Hangfire + Job State)
REDIS_PORT=6379

# MinIO (S3-сумісне сховище скріншотів та PDF)
MINIO_ROOT_USER=leadlens_minio
MINIO_ROOT_PASSWORD=leadlens_minio_secret_change_me
MINIO_BUCKET=leadlens-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ASP.NET Core Web API
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=dev_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=leadlens-api
JWT_AUDIENCE=leadlens-web
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
INTERNAL_SERVICE_TOKEN=dev_internal_service_token_change_me

# Python FastAPI Services
CRAWLER_PORT=8001
AUDIT_PORT=8002
ML_PORT=8003
CRAWLER_USER_AGENT=LeadLensBot/1.0 (+https://leadlens.local/bot; contact=bot@leadlens.local)
CRAWLER_MAX_CONCURRENT_AUDITS=5
CRAWLER_RATE_LIMIT_RPS=1.0
AUDIT_TIMEOUT_SECONDS=120

# Google Places API (резерв під дипломну роботу; у курсовій використовується безкоштовний OpenStreetMap Overpass API, CSV та ручний список)
GOOGLE_PLACES_API_KEY=

# Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
